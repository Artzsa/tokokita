DATABASE_URL="file:./dev.db"
AUTH_SECRET="ganti-ini-dengan-string-acak-panjang-sebelum-online"

# Isi nanti saat toko sudah punya domain, untuk URL absolut di metadata & OG.
# NEXT_PUBLIC_SITE_URL="https://tokokita.example"

# Bot WhatsApp (Baileys — tidak resmi, pakai dengan bijak)
# qr | pairing
BOT_LOGIN_METHOD="qr"
# Wajib kalau BOT_LOGIN_METHOD=pairing, format 62xxx tanpa + / spasi
# BOT_PAIR_NUMBER="6281234567890"
# Cadangan nomor WhatsApp toko kalau BOT_PAIR_NUMBER belum diisi.
# Bot membalas semua nomor (whitelist dinonaktifkan).
BOT_ALLOWED_NUMBERS="6281234567890"
BOT_SESSION_DIR="bot/session"
# true = tidak menyambung WA, cocok untuk uji alur outbox tanpa akun
BOT_DRY_RUN="true"
BOT_POLL_MS="5000"
BOT_MAX_ATTEMPTS="3"
BOT_SWEEP_MS="21600000"
